{
  "version": 2,
  "builds": [
    {
      "src": "topup_panel/app.py",
      "use": "@vercel/python"
    },
    {
      "src": "topup_panel/static/**/*",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "topup_panel/static/(.*)",
      "dest": "/static/$1"
    },
    {
      "src": "topup_panel/(.*)",
      "dest": "/app.py"
    }
  ]
}
